{
  "name": "us-market-close-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test --test-isolation=none dist/tests/*.test.js",
    "blogger:oauth": "npm run build && node dist/src/blogger-oauth-cli.js",
    "editorial:review": "npm run build && node dist/src/cli.js --editorial-review-preview",
    "editorial:layout-preview": "npm run build && node dist/src/cli.js --editorial-layout-preview",
    "editorial:research-preview": "npm run build && node dist/src/cli.js --financial-research-layout-preview",
    "editorial:market-trend-preview": "npm run build && node scripts/build-market-trend-preview.mjs",
    "intelligence:golden-rehearsal": "npm run build && node dist/src/golden-rehearsal-cli.js",
    "intelligence:golden-review": "npm run build && node dist/src/golden-review-cli.js",
    "intelligence:editorial-ia-preview": "npm run build && node dist/src/editorial-ia-preview-cli.js",
    "intelligence:split-daily": "npm run build && node dist/src/split-daily-production-cli.js",
    "intelligence:periodic-preview": "npm run build && node dist/src/periodic-production-cli.js",
    "motus:daily": "npm run build && node dist/src/daily-operations-cli.js",
    "motus:search": "npm run build && node dist/src/search-operations-cli.js",
    "motus:report": "npm run build && node dist/src/report-production-cli.js",
    "sample": "npm run build && node dist/src/cli.js --sample",
    "report": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
